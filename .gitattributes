# 统一换行符：文本文件在仓库里存 LF，检出到 Windows 时自动转 CRLF
* text=auto eol=lf

# Windows 脚本必须保持 CRLF，否则 cmd.exe 解析 .bat/.cmd 可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.7z binary

# 通过 Git LFS 管理大体积二进制（当前仓库无此类文件，作为后续防呆规则保留）
*.bin filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
